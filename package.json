{
  "name": "tubegrab",
  "version": "2.0.0",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/postinstall.js",
    "build": "electron-builder"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.tubegrab.app",
    "productName": "TubeGrab Pro",
    "asar": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TubeGrab.exe"
    },
    "cscLink": null,
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.2.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
