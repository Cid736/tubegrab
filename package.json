{
  "name": "tubegrab",
  "version": "3.10.2",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/postinstall.js",
    "build": "electron-builder",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "build:lite": "electron-builder --config electron-builder.lite.js",
    "cli": "node cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.tubegrab.app",
    "productName": "TubeGrab Pro",
    "asar": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TubeGrab.exe"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "cli.js",
      "package.json",
      "lib/**/*",
      "public/**/*",
      "extension/**/*",
      "build/icon.ico",
      "bin/ffmpeg.exe",
      "bin/ffprobe.exe",
      "yt-dlp.exe",
      "!node_modules/ffmpeg-static/*.exe"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TubeGrab-Setup.exe",
      "shortcutName": "TubeGrab",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "bin": {
    "tubegrab": "cli.js"
  }
}
